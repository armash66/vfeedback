APP_ENV=development
APP_URL=http://localhost:5173

POSTGRES_USER=vfeedback
POSTGRES_DB=vfeedback
POSTGRES_PORT=5432
POSTGRES_PASSWORD=change-me
DATABASE_URL=

SESSION_SECRET=change-me

VOSS_CLIENT_ID=
VOSS_CLIENT_SECRET=

# Set both to enable Cloudflare Turnstile. Cloudflare's public test keys for local testing: 1x00000000000000000000AA and 1x0000000000000000000000000000000AA.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Proxy trust configuration for client address extraction:
# - "none" (default when unset or unknown): ignores forwarded headers, returns "unknown"
# - "cloudflare": uses only cf-connecting-ip
# - "proxy": uses the rightmost entry of x-forwarded-for
TRUST_PROXY=none

